APP_NAME=Matrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Option A: Supabase (PostgreSQL) - Recommended for Production / Supabase Cloud
# In Supabase Dashboard -> Project Settings -> Database -> Connection string:
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-database-password
# DB_SSLMODE=require

# Option B: SQLite (Quick Local Development)
DB_CONNECTION=sqlite
# DB_DATABASE=/Users/rizkygiovanni/Documents/matrack/backend/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SANCTUM_STATEFUL_DOMAINS="localhost:5173,127.0.0.1:5173"
