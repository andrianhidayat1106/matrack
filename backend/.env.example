APP_NAME=Matrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (SUPABASE POSTGRESQL POOLER - IPv4 Compatible)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.[YOUR-PROJECT-ID]
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# Option B: SQLite (Quick Local Development)
# DB_CONNECTION=sqlite
# DB_DATABASE=/Users/rizkygiovanni/Documents/matrack/backend/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SANCTUM_STATEFUL_DOMAINS="localhost:5173,127.0.0.1:5173"
